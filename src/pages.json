{
	"easycom": {
		"autoscan": true,
		"custom": {
			// uni-ui 规则如下配置
			"^uni-((?!(shadow-root|icons)).*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue" //这里排除了uni-shadow-root，uni-icons  
		}
	},
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages	
		{
			"path": "pages/index/index",
			"style": {
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/home/index",
			"style": {
				"navigationStyle":"custom"  
			}
		},
		{
			"path": "pages/photo/index",
			"style": {
				"navigationStyle":"custom"  
			}
		},
		{
			"path": "pages/chat/index",
			"style": {
				"navigationStyle":"custom"  
			}
		},
		{
			"path": "pages/user/index",
			"style": {
				"navigationStyle":"custom"  
			}
		}
	    ,{
            "path" : "pages/home/confirm",
            "style" :                                                                                    
            {
                "navigationBarTitleText": "",
                "enablePullDownRefresh": false
            }
            
        }
        ,{
            "path" : "pages/photo/imgdetail",
            "style" :                                                                                    
            {
                "navigationBarTitleText": "图片详情",
                "enablePullDownRefresh": false
            }
            
        }
        ,{
            "path" : "pages/home/result",
            "style" :                                                                                    
            {
                "navigationBarTitleText": "",
                "enablePullDownRefresh": false
            }
            
        }
    ],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	}, 
	"tabBar": {
		"color": "#767676",
		"selectedColor": "#4F89F1",
		"borderStyle": "black",
		"backgroundColor": "#ffffff",
		"list":[{
			"pagePath": "pages/home/index",
			"iconPath": "static/icon/home1.png",
			"selectedIconPath": "static/icon/home2.png",
			"text": "首页"
		},{
			"pagePath": "pages/photo/index",
			"iconPath": "static/icon/photo1.png",
			"selectedIconPath": "static/icon/photo2.png",
			"text": "相册"
		},{
			"pagePath": "pages/chat/index",
			"iconPath": "static/icon/chat1.png",
			"selectedIconPath": "static/icon/chat2.png",
			"text": "通讯"
		},{
			"pagePath": "pages/user/index",
			"iconPath": "static/icon/user1.png",
			"selectedIconPath": "static/icon/user2.png",
			"text": "个人中心"
		}]
	}
}
